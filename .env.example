# Mini-SIEM environment configuration
#
# Copy this file to `.env` and edit the values. `.env` is git-ignored, so real
# secrets never reach the repository.
#
#   cp .env.example .env        (Windows: copy .env.example .env)

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Signs the session cookie and CSRF tokens. Generate your own, never reuse the
# example value, and never commit the real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# Defaults to a SQLite file in instance/. Override for another database.
# SQLALCHEMY_DATABASE_URI=sqlite:///C:/path/to/mini_siem.db

# ---------------------------------------------------------------------------
# SESSION SECURITY
# ---------------------------------------------------------------------------

# Set to true only when serving over HTTPS — otherwise login will not work.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# DETECTION RULE THRESHOLDS (proposal Section 10.2)
# ---------------------------------------------------------------------------

# R-01: number of authentication failures for the same user/IP, and the window
# they must fall inside, before an alert is raised.
DETECTION_FAILED_LOGIN_THRESHOLD=5
DETECTION_FAILED_LOGIN_WINDOW_MINUTES=10

# R-04: how many distinct hosts one source IP must attack to escalate.
DETECTION_MULTI_HOST_THRESHOLD=2

# ---------------------------------------------------------------------------
# OPTIONAL: live Linux log collection over SSH
# ---------------------------------------------------------------------------
#
# Only needed to pull real logs from an authorized Linux host. Leave unset to
# run the project entirely on sample and synthetic data.
#
# Prefer key-based authentication over a password. Never point this at a
# machine you do not own or have written permission to monitor.

SSH_DEFAULT_HOST=127.0.0.1
SSH_DEFAULT_USER=siem-admin
SSH_DEFAULT_PORT=2222
# SSH_KEY_FILE=C:/Users/you/.ssh/id_ed25519
# SSH_PASSWORD=

# ---------------------------------------------------------------------------
# OPTIONAL: remote Windows log collection over WinRM
# ---------------------------------------------------------------------------
#
# Lets the dashboard read the Security log of another Windows PC. Only point
# this at machines you own or have written permission to monitor.
#
# On the TARGET PC, from an Administrator PowerShell:
#     Enable-PSRemoting -Force
#
# On THIS machine, if the target is not domain-joined:
#     Set-Item WSMan:\localhost\Client\TrustedHosts -Value '192.168.100.68' -Force
#
# The account must be a local Administrator on the target. For a workgroup PC
# the username normally needs the form COMPUTERNAME\User.
#
# The password is read from here and never written to the database, so it
# cannot leak into backups, Parquet archives or a repository.

# MINISIEM_WINRM_USER=LAB-PC\Administrator
# MINISIEM_WINRM_PASSWORD=
# MINISIEM_WINRM_PORT=5985
# MINISIEM_WINRM_USE_SSL=false
# MINISIEM_WINRM_AUTH=Default

# Per-host override, keyed by hostname uppercased with non-alphanumerics
# replaced by underscores. A host named "Lab PC-2" reads LAB_PC_2:
# MINISIEM_WINRM_PASSWORD_LAB_PC_2=

# ---------------------------------------------------------------------------
# AUTOMATIC COLLECTION (BACKGROUND SCHEDULER)
# ---------------------------------------------------------------------------
#
# With this on, Mini-SIEM collects from monitored hosts by itself instead of
# waiting for someone to press Collect. Nothing is collected until automatic
# collection is switched on for an individual host on the Configuration page,
# so enabling it here is safe on its own.
#
# Set to false to return to purely manual collection.
SCHEDULER_ENABLED=true

# How often the scheduler wakes up to ask which hosts are due. This is not the
# collection interval -- that is set per host, in seconds, in the interface --
# only how precisely due times are noticed. Keep it at or below the shortest
# per-host interval in use, or every host is effectively rounded up to this.
SCHEDULER_TICK_SECONDS=5

# ---------------------------------------------------------------------------
# HOW TIMES ARE DISPLAYED
# ---------------------------------------------------------------------------
#
# Events, alerts and scans are always *stored* in UTC, so that a Windows PC in
# one country and a Linux server in another can be correlated at all. This
# setting only decides which wall clock the dashboard renders them against.
#
# The default is Pakistan Standard Time (Asia/Karachi, UTC+05:00), and leaving
# this blank keeps it. The display is pinned rather than taken from the
# viewing browser on purpose: an analyst has to be able to state when an
# incident happened, and a machine whose clock is set to the wrong region --
# a fresh Windows install often is -- would otherwise relabel every event on
# screen without saying so.
#
# Set any other IANA zone name to move the display:
# MINISIEM_DISPLAY_TIMEZONE=Europe/London
#
# Or the literal word "local" to go back to using the viewing machine's own
# timezone:
# MINISIEM_DISPLAY_TIMEZONE=local
MINISIEM_DISPLAY_TIMEZONE=

# ---------------------------------------------------------------------------
# UPLOADS
# ---------------------------------------------------------------------------

# Maximum size of an imported sample log file, in bytes (default 2 MB).
MAX_UPLOAD_BYTES=2097152
